command = "scripts/run-kernel.sh hlasm.s --load-binary demos/d40_long_range_jumps.bin@524288 --speed 0 -n 3500000 2>&1"
timeout = 30
preprocess = "grep -A 260 '^UART output:' || true"
exit_code = 0
desc = "Demo 40: structured jumps beyond bra range use push r2 / la r2,L_far / jmp (r2) with an L_far trampoline"
