; button.c in hlasm: return the button S2 bit (0 = pressed, 1 = released).
; Output: "r0=1" when released, "r0=0" when run with --switch on.
COPY cor24
COPY frame
COPY svc_bare
COPY board
SET SHOWRC,1
 START
_main:
 PROLOG
 CALL _button_pressed
 RET

; _button_pressed(): bit 0 of the button register
_button_pressed:
 PROLOG
 BUTTON
 RET
COPY svc_bare_code
