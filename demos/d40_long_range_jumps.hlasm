; Demo 40: structured jumps beyond bra range.
; The loop body is 40 four-byte instructions (160 bytes), so DOEXIT's jump
; to the loop end, the backward jump to the top, and the IF's jump past its
; long THEN body are out of bra range. hlasm emits push r2 / la r2,L_far /
; jmp (r2) for them, with a bra L / L_far: / pop r2 trampoline at each
; target. Assembled and run on cor24-emu, it prints r0 then r1 as digits.
; Per docs/design.md DOEXIT exits when its condition is true, giving "32"
; (r0 = 3 at exit, r1 = 2 completed passes). Until the DOEXIT polarity fix
; lands, hlasm exits when the condition is false and this prints "10".
 lc r0,0
 lc r1,0
DO
 add r0,1
 DOEXIT cc_eq, r0, 3
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 add r1,1
ENDDO
IF cc_ne, r1, 2
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 la r2,0
 lc r1,0
ENDIF
 la r2,-65280
 add r0,48
 sb r0,0(r2)
txwait:
 lb r0,1(r2)
 cls r0,z
 brt txwait
 add r1,48
 sb r1,0(r2)
halt:
 bra halt
